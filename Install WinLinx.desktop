[Desktop Entry]
Type=Application
Name=Install WinLinx
Comment=Install WinLinx - Windows programs and VSTs on Linux, zero setup
Exec=/usr/bin/python3 -c "import os,subprocess,sys; d=os.path.dirname(sys.argv[1]) if len(sys.argv)>1 and sys.argv[1] else os.getcwd(); os.chdir(d); subprocess.call([sys.executable, 'install-winlinx.py'])" %k
Icon=system-software-install
Terminal=false
Categories=System;
